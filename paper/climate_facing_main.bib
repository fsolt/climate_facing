@article{Goh2016,
	abstract = {Abstract We outline the need to, and provide a guide on how to, conduct a meta-analysis on one's own studies within a manuscript. Although conducting a ``mini meta'' within one's manuscript has been argued for in the past, this practice is still relatively rare and adoption is slow. We believe two deterrents are responsible. First, researchers may not think that it is legitimate to do a meta-analysis on a small number of studies. Second, researchers may think a meta-analysis is too complicated to do without expert knowledge or guidance. We dispel these two misconceptions by (1) offering arguments on why researchers should be encouraged to do mini metas, (2) citing previous articles that have conducted such analyses to good effect, and (3) providing a user-friendly guide on calculating some meta-analytic procedures that are appropriate when there are only a few studies. We provide formulas for calculating effect sizes and converting effect sizes from one metric to another (e.g., from Cohen's d to r), as well as annotated Excel spreadsheets and a step-by-step guide on how to conduct a simple meta-analysis. A series of related studies can be strengthened and better understood if accompanied by a mini meta-analysis.},
	author = {Goh, Jin X. and Hall, Judith A. and Rosenthal, Robert},
	date-added = {2026-07-26 11:44:16 +0100},
	date-modified = {2026-07-26 11:44:16 +0100},
	eprint = {https://compass-onlinelibrary-wiley-com.proxy.lib.uiowa.edu/doi/pdf/10.1111/spc3.12267},
	journal = {Social and Personality Psychology Compass},
	number = {10},
	pages = {535-549},
	title = {Mini Meta-Analysis of Your Own Studies: Some Arguments on Why and a Primer on How},
	volume = {10},
	year = {2016},
	bdsk-file-1 = {},
	bdsk-url-1 = {https://compass-onlinelibrary-wiley-com.proxy.lib.uiowa.edu/doi/abs/10.1111/spc3.12267},
	bdsk-url-2 = {https://doi-org.proxy.lib.uiowa.edu/10.1111/spc3.12267}}

